# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kerala_climate
POSTGRES_USER=kerala_user
POSTGRES_PASSWORD=changeme

# Constructed by the app — do not set manually
# DATABASE_URL=postgresql://kerala_user:changeme@localhost:5432/kerala_climate

# ── Ingestion settings ─────────────────────────────────────────────────────────
BRONZE_DIR=data/bronze
DISTRICTS_CSV=districts.csv
# How many past days of history to back-fill on first run
BACKFILL_DAYS=7
# Retry configuration for HTTP calls
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=2         # seconds (doubles each retry)

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false               # set true for local dev

# ── Timezone ───────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata          # IST = UTC+5:30

# ── Optional: LangChain / OpenAI (text-to-SQL) ────────────────────────────────
OPENAI_API_KEY=sk-replace-me
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
